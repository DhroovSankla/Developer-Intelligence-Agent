# Phase 1: Compile bundle assets
FROM node:20-alpine AS builder
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .
# Compile code down to static production assets inside the /app/dist directory
RUN npm run build

# Phase 2: Serve static production assets via Nginx
FROM nginx:stable-alpine
COPY --from=builder /app/dist /usr/share/nginx/html
# Re-route Nginx internal routing controls cleanly to support SPA client routers
COPY nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]